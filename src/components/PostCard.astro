---
import type { CollectionEntry } from "astro:content";
interface Props {
  post: CollectionEntry<"blog">;
  type: "weblog" | "devlog" | "writing";
}
const { post, type } = Astro.props;
const { title, pubDatetime, description } = post.data;
const date = pubDatetime.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "America/Los_Angeles",
});
---

<article class="feed-entry">
  <div class="feed-meta">
    <time datetime={pubDatetime.toISOString()}>{date}</time> · {type}
  </div>
  <h3><a href={`/posts/${post.id}/`}>{title}</a></h3>
  <p class="post-description">{description}</p>
</article>
