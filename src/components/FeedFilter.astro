---
import type { FeedFilter } from "@utils/getFeedPosts";
import { feedRoute } from "@utils/getFeedPosts";
interface Props {
  filter: FeedFilter;
}
const { filter } = Astro.props;
const filters = [
  { id: "all", label: "all" },
  { id: "weblog", label: "weblogs" },
  { id: "devlog", label: "devlogs" },
  { id: "writing", label: "writings" },
] as const;
---

<nav aria-label="Post type" class="feed-filter">
  {
    filters.map((item) => (
      <a
        href={feedRoute(item.id, 1)}
        aria-current={item.id === filter ? "page" : undefined}
      >
        {item.label}
      </a>
    ))
  }
</nav>
<style>
  .feed-filter {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    font:
      0.7rem/1.6 Arial,
      sans-serif;
    color: rgba(var(--color-text-base), 0.65);
  }
  a[aria-current="page"] {
    color: rgb(var(--color-text-base));
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  a:hover {
    color: rgb(var(--color-accent));
  }
</style>
