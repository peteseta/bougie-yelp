---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
  transition?: boolean;
}

const { tag, size = "sm", transition = true } = Astro.props;
---

<li
  class={`inline-block ${
    size === "sm" ? "my-1 underline-offset-4" : "my-3 mx-1 underline-offset-8"
  }`}
>
  <a
    href={`/tags/${tag}/`}
    class={`${size === "sm" ? "text-sm" : "text-lg"} pr-2`}
    style={transition ? `view-transition-name: ${tag}` : ""}
  >
    <span>{tag}</span>
  </a>
</li>

<style>
  a {
    @apply underline decoration-solid hover:text-skin-accent;
    font-family: Arial, sans-serif;
    font-size: 0.75rem;
    color: rgba(var(--color-text-base), 0.65);
  }
</style>
