---
interface Props {
  nextPage: string | null;
  nextRoute: string | null;
}
const { nextPage, nextRoute } = Astro.props;
---

<div
  id="feed-list"
  data-next-page={nextPage ?? ""}
  data-next-route={nextRoute ?? ""}
>
  <slot />
</div>
<div class="feed-navigation">
  <p id="feed-status" role="status" aria-live="polite"></p>
  {
    nextPage && (
      <>
        <>
          <div id="feed-sentinel" aria-hidden="true" />
          <a id="feed-next" href={nextRoute!}>
            Older posts →
          </a>
        </>
      </>
    )
  }
</div>
<style>
  .feed-navigation {
    font-size: 0.85rem;
    color: rgba(var(--color-text-base), 0.7);
  }
  #feed-status:not(:empty) {
    margin-bottom: 0.75rem;
  }
  #feed-next:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  #feed-sentinel {
    height: 1px;
  }
</style>
<script>
  let cleanup = () => {};
  function init() {
    cleanup();
    const list = document.querySelector<HTMLElement>("#feed-list");
    const sentinel = document.querySelector<HTMLElement>("#feed-sentinel");
    const next = document.querySelector<HTMLAnchorElement>("#feed-next");
    const status = document.querySelector<HTMLElement>("#feed-status");
    if (!list || !sentinel || !next || !status || !list.dataset.nextPage)
      return;
    let loading = false;
    const controller = new AbortController();
    const observer = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting || loading || !list.dataset.nextPage) return;
        loading = true;
        list.setAttribute("aria-busy", "true");
        status.textContent = "Loading older posts…";
        try {
          const response = await fetch(list.dataset.nextPage, {
            signal: controller.signal,
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const doc = new DOMParser().parseFromString(
            await response.text(),
            "text/html",
          );
          const incoming = doc.getElementById("feed-list");
          if (!incoming) throw new Error("Missing feed");
          if (controller.signal.aborted) return;
          list.append(...Array.from(incoming.children));
          list.dataset.nextPage = incoming.dataset.nextPage ?? "";
          list.dataset.nextRoute = incoming.dataset.nextRoute ?? "";
          status.textContent = "";
          if (list.dataset.nextPage && list.dataset.nextRoute)
            next.href = list.dataset.nextRoute;
          else {
            observer.disconnect();
            sentinel.remove();
            next.remove();
          }
        } catch (error) {
          if (controller.signal.aborted) return;
          observer.disconnect();
          status.textContent =
            "Couldn’t load more posts. Use Older posts to continue.";
          console.error("Feed loading failed:", error);
        } finally {
          loading = false;
          list.removeAttribute("aria-busy");
        }
      },
      { rootMargin: "400px 0px" },
    );
    observer.observe(sentinel);
    cleanup = () => {
      controller.abort();
      observer.disconnect();
    };
  }
  init();
  document.addEventListener("astro:before-swap", () => cleanup());
  document.addEventListener("astro:page-load", init);
</script>
