---
import { SITE } from "@config";
import Utilities from "./Utilities.astro";
export interface Props {
  noMarginTop?: boolean;
  showIdentity?: boolean;
  readingColumn?: boolean;
}
const {
  noMarginTop = false,
  showIdentity = false,
  readingColumn = false,
} = Astro.props;
---

<footer
  class:list={[
    "site-footer",
    { "mt-auto": !noMarginTop, "site-footer--reading": readingColumn },
  ]}
>
  {
    showIdentity && (
      <a class="footer-name" href="/">
        {SITE.title}
      </a>
    )
  }
  <Utilities />
</footer>
<style>
  .site-footer {
    margin-inline: auto;
    width: 100%;
    max-width: 1020px;
    padding: 2rem 3.875rem;
  }
  .footer-name {
    display: block;
    margin-bottom: 1.25rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  @media (max-width: 767px) {
    .site-footer {
      padding: 2rem 1.5rem;
    }
  }
  .site-footer.site-footer--reading {
    padding: 3rem 0 0;
  }
</style>
