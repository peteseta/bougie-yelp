---
import type { CollectionEntry } from "astro:content";
import FeedItems from "./FeedItems.astro";
interface Props {
  posts: CollectionEntry<"blog">[];
  nextPage: string | null;
  nextRoute: string | null;
}
const { posts, nextPage, nextRoute } = Astro.props;
---

<div id="feed-section"><FeedItems {posts} {nextPage} {nextRoute} /></div>
