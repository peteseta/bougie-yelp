---
import { SITE } from "@config";
export interface Props {
  sidebarIdentity?: boolean;
  hideIdentity?: boolean;
}
const { sidebarIdentity = false, hideIdentity = false } = Astro.props;
---

<header
  class:list={[
    "masthead",
    { "masthead--sidebar": sidebarIdentity, "masthead--hidden": hideIdentity },
  ]}
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  {
    !hideIdentity && (
      <a class="site-name" href="/">
        {SITE.title}
      </a>
    )
  }
</header>
<style>
  .masthead {
    width: 100%;
    max-width: 1020px;
    margin: 0 auto;
    padding: 3.6rem 3.875rem 3.5rem;
  }
  .masthead.masthead--hidden {
    padding: 0;
  }
  .site-name {
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .skip-link {
    position: absolute;
    top: -100px;
    background: rgb(var(--color-fill));
    padding: 0.75rem;
    z-index: 100;
  }
  .skip-link:focus {
    top: 1rem;
  }
  @media (min-width: 768px) {
    .masthead--sidebar {
      padding: 0;
    }
    .masthead--sidebar .site-name {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .masthead {
      padding: 2rem 1.5rem 1.5rem;
    }
  }
</style>
