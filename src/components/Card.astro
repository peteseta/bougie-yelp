---
import { slugifyStr } from "@utils/slugify";
import type { CollectionEntry } from "astro:content";
import getPostType from "@utils/getPostType";

export interface Props {
  href?: string;
  post: CollectionEntry<"blog">;
  secHeading?: boolean;
}

const { href, post, secHeading = true } = Astro.props;
const { title, pubDatetime, description } = post.data;
const postType = getPostType(post);
const date = pubDatetime.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "America/Los_Angeles",
});

const headerStyle = { viewTransitionName: slugifyStr(title) };
---

<li>
  <div class="feed-meta">
    <time datetime={pubDatetime.toISOString()}>{date}</time> · {postType}
  </div>
  <a href={href ?? `/posts/${post.id}/`}>
    {
      secHeading ? (
        <h2 style={headerStyle}>{title}</h2>
      ) : (
        <h3 style={headerStyle}>{title}</h3>
      )
    }
  </a>
  <p>{description}</p>
</li>

<style>
  li {
    margin: 0;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(var(--color-text-base), 0.16);
  }
  h2,
  h3 {
    font:
      600 1.4rem/1.25 "Source Serif 4",
      Georgia,
      serif;
    color: rgb(var(--color-text-base));
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  h2,
  h3 {
    margin-top: 0.4rem;
  }
  li > p:last-child {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-top: 0.5rem;
  }
</style>
