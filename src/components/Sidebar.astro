---
import { SITE } from "@config";
import { getPlaylistTracks } from "@utils/spotify";
import currently from "../data/currently.json";
import Utilities from "./Utilities.astro";
const reading = currently.reading;
const playlistId = currently.listening?.spotifyPlaylistId;
const tracks =
  playlistId && playlistId !== "REPLACE_WITH_PLAYLIST_ID"
    ? await getPlaylistTracks(playlistId)
    : [];
---

<aside class="sidebar">
  <div class="desktop-utilities">
    <a class="sidebar-name" href="/">{SITE.title}</a>
    <Utilities />
  </div>
  {
    reading.length > 0 && (
      <section>
        <>
          <h2>I'm reading...</h2>
          <ul>
            {reading.map((book) => (
              <li>
                {book.title}
                <span>{book.author}</span>
              </li>
            ))}
          </ul>
        </>
      </section>
    )
  }
  {
    tracks.length > 0 && (
      <section>
        <>
          <h2>I like to listen to...</h2>
          <ul>
            {tracks.map((track) => (
              <li>
                {track.title}
                <span>{track.artist}</span>
              </li>
            ))}
          </ul>
        </>
      </section>
    )
  }
</aside>
<style>
  .sidebar {
    font:
      0.75rem/1.65 Arial,
      sans-serif;
  }
  .sidebar-name {
    display: block;
    margin-bottom: 1.25rem;
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.025em;
  }
  .desktop-utilities {
    margin-bottom: 2.75rem;
  }
  section {
    padding: 0;
    margin: 0 0 2rem;
  }
  h2 {
    font-size: 0.7rem;
    font-weight: 400;
    color: rgba(var(--color-text-base), 0.65);
    margin-bottom: 1rem;
  }
  li {
    line-height: 1.35;
    margin-bottom: 1rem;
  }
  li span {
    display: block;
    color: rgba(var(--color-text-base), 0.65);
    font-size: 0.7rem;
    margin-top: 0;
  }

  @media (max-width: 767px) {
    .sidebar {
      border-top: 1px solid rgb(var(--color-border));
      padding-top: 1.5rem;
      margin-top: 2.5rem;
    }
    .desktop-utilities {
      display: none;
    }
  }
</style>
