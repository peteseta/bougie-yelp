---
import { render, type CollectionEntry } from "astro:content";
import { extractLinkCardUrls } from "@utils/extractLinkCardUrl";
import FeedLinkPlaceholder from "./FeedLinkPlaceholder.astro";
interface Props {
  post: CollectionEntry<"blog">;
  linkUrl: string | null;
}
const { post, linkUrl } = Astro.props;
const { title, pubDatetime } = post.data;
const { Content } = await render(post);
const additionalLinks = extractLinkCardUrls(post.body ?? "").slice(1);
const date = pubDatetime.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "America/Los_Angeles",
});
let domain = "";
try {
  domain = linkUrl ? new URL(linkUrl).hostname.replace(/^www\./, "") : "";
} catch {
  /* Local permalink is still available. */
}
---

<article class="feed-entry weblog">
  <div class="feed-meta">
    <a href={`/posts/${post.id}/`} aria-label={`Permalink: ${title}`}
      ><time datetime={pubDatetime.toISOString()}>{date}</time></a
    >
  </div>
  <h3>
    <a href={linkUrl || `/posts/${post.id}/`}
      >{title}{
        linkUrl && (
          <span class="external-arrow" aria-hidden="true">
            {" "}
            ↗
          </span>
        )
      }</a
    >
  </h3>
  {domain && <p class="weblog-source">{domain}</p>}
  {
    additionalLinks.length > 0 && (
      <ul class="additional-sources">
        {additionalLinks.map((url) => (
          <li>
            <a href={url}>
              {new URL(url).hostname.replace(/^www\./, "")}{" "}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <div class="feed-commentary">
    <Content components={{ LinkCard: FeedLinkPlaceholder }} />
  </div>
</article>

<style>
  .weblog-source {
    margin: 0.25rem 0 0;
    font:
      0.7rem/1.5 Arial,
      sans-serif;
    color: rgba(var(--color-text-base), 0.65);
    overflow-wrap: anywhere;
  }
  .additional-sources {
    margin-top: 0.65rem;
    font-size: 0.85rem;
  }
  .additional-sources a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
