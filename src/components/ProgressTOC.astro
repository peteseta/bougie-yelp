---
import type { MarkdownHeading } from "astro";
interface Props {
  headings: MarkdownHeading[];
  title: string;
}
const { headings } = Astro.props;
const items = headings.filter(
  (h) => h.text !== "Footnotes" && h.depth >= 1 && h.depth <= 3,
);
---

{
  items.length >= 2 && (
    <aside
      id="progress-toc"
      class="progress-toc"
      aria-label="Table of contents"
    >
      <button class="toc-top quiet-action" type="button">
        Go back to top
      </button>
      <button
        class="toc-toggle quiet-action"
        type="button"
        aria-expanded="false"
        aria-controls="toc-sections"
      >
        Contents <span aria-hidden="true">⌄</span>
      </button>
      <nav id="toc-sections" aria-label="Article sections">
        <ul>
          {items.map((h) => (
            <li data-depth={h.depth}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}

<style>
  .progress-toc {
    position: fixed;
    left: 2rem;
    top: var(--toc-top, 4rem);
    width: 180px;
    max-height: calc(100dvh - var(--toc-top, 4rem) - 2rem);
    overflow-y: auto;
    scrollbar-width: thin;
    font:
      0.72rem/1.5 Arial,
      sans-serif;
  }
  .toc-top {
    display: none;
    color: rgba(var(--color-text-base), 0.5);
    text-decoration: none;
  }
  .toc-top:hover {
    color: rgba(var(--color-text-base), 0.8);
    text-decoration: none;
  }
  @media (min-width: 1280px) {
    .progress-toc.is-stuck .toc-top {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 1.25rem;
    }
  }
  .toc-toggle {
    display: none;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid rgba(var(--color-text-base), 0.16);
  }
  li {
    position: relative;
    margin: 0;
  }
  li[hidden] {
    display: none;
  }
  a {
    display: block;
    padding: 0.45rem 0 0.45rem 0.9rem;
    color: rgba(var(--color-text-base), 0.55);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  li[data-depth="3"] a {
    padding-left: 1.5rem;
    font-size: 0.68rem;
  }
  a[aria-current="location"] {
    color: rgb(var(--color-text-base));
  }
  a[aria-current="location"]::before {
    content: "";
    position: absolute;
    left: -1px;
    top: calc(0.45rem + var(--section-progress, 0) * (100% - 1.8rem));
    width: 2px;
    height: 0.9rem;
    background: rgb(var(--color-accent));
  }
  a:hover {
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a:focus-visible,
  .toc-toggle:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 3px;
  }
  @media (max-width: 1279px) {
    .progress-toc {
      position: static;
      width: 100%;
      max-width: none;
      max-height: none;
      overflow: visible;
      margin: 0 0 1.5rem;
      padding: 0.75rem 0;
      border-block: 1px solid rgba(var(--color-text-base), 0.16);
    }
    .toc-toggle {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
      justify-content: space-between;
      text-decoration: none;
    }
    nav {
      display: none;
      margin-top: 1rem;
      padding-bottom: 0.5rem;
    }
    .progress-toc.is-open nav {
      display: block;
    }
    .progress-toc.is-open .toc-toggle span {
      transform: rotate(180deg);
    }
    a {
      padding-top: 0.7rem;
      padding-bottom: 0.7rem;
    }
  }
</style>

<script>
  let dispose: (() => void) | undefined;
  function setupContents() {
    dispose?.();
    const toc = document.querySelector<HTMLElement>("#progress-toc");
    const article = document.querySelector<HTMLElement>("#article");
    const toggle = toc?.querySelector<HTMLButtonElement>(".toc-toggle");
    if (!toc || !article || !toggle) return;
    const entries = Array.from(
      toc.querySelectorAll<HTMLAnchorElement>("nav a"),
    ).flatMap((link) => {
      const heading = document.getElementById(
        decodeURIComponent(link.hash.slice(1)),
      );
      return heading ? [{ link, heading, item: link.parentElement! }] : [];
    });
    const controller = new AbortController();
    const { signal } = controller;
    let frame = 0;
    function close() {
      toc!.classList.remove("is-open");
      toggle!.setAttribute("aria-expanded", "false");
    }
    function update() {
      frame = 0;
      if (!toc || !article) return;
      const rect = article.getBoundingClientRect();
      toc.classList.toggle("is-stuck", rect.top <= 32);
      toc.style.setProperty("--toc-top", `${Math.max(32, rect.top)}px`);
      toc.style.visibility = rect.bottom < 0 ? "hidden" : "visible";
      const visible = entries.filter(({ heading, item }) => {
        let parent = heading.parentElement;
        let hidden = false;
        while (parent && parent !== article) {
          if (parent instanceof HTMLDetailsElement && !parent.open)
            hidden = true;
          parent = parent.parentElement;
        }
        item.hidden = hidden;
        return !hidden;
      });
      const anchor = Math.min(180, window.innerHeight * 0.25);
      let active = -1;
      visible.forEach(({ heading }, index) => {
        if (heading.getBoundingClientRect().top <= anchor) active = index;
      });
      entries.forEach(({ link }) => link.removeAttribute("aria-current"));
      if (active >= 0) {
        const current = visible[active];
        const start = current.heading.getBoundingClientRect().top;
        const end =
          visible[active + 1]?.heading.getBoundingClientRect().top ??
          rect.bottom;
        const progress = Math.max(
          0,
          Math.min(1, (anchor - start) / Math.max(1, end - start)),
        );
        current.link.setAttribute("aria-current", "location");
        current.item.style.setProperty("--section-progress", String(progress));
      }
    }
    function schedule() {
      if (!frame) frame = requestAnimationFrame(update);
    }
    toc.querySelector<HTMLButtonElement>(".toc-top")?.addEventListener(
      "click",
      () => {
        window.scrollTo({
          top: 0,
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
            .matches
            ? "instant"
            : "smooth",
        });
      },
      { signal },
    );
    toggle.addEventListener(
      "click",
      () => {
        const open = toc.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", String(open));
      },
      { signal },
    );
    toc.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          close();
          toggle.focus();
        }
      },
      { signal },
    );
    entries.forEach(({ link }) =>
      link.addEventListener("click", close, { signal }),
    );
    document.addEventListener(
      "click",
      (event) => {
        if (event.target instanceof Node && !toc.contains(event.target))
          close();
      },
      { signal },
    );
    article.addEventListener("toggle", schedule, { capture: true, signal });
    window.addEventListener("scroll", schedule, { passive: true, signal });
    window.addEventListener("resize", schedule, { signal });
    const observer = new ResizeObserver(schedule);
    observer.observe(article);
    update();
    dispose = () => {
      controller.abort();
      observer.disconnect();
      cancelAnimationFrame(frame);
    };
  }
  document.addEventListener("astro:before-swap", () => dispose?.());
  document.addEventListener("astro:page-load", setupContents);
  setupContents();
</script>
