---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
interface Props {
  page: Page<CollectionEntry<"blog">>;
}
import { getCollection } from "astro:content";
import FeedSection from "@components/FeedSection.astro";
import {
  getFeedPosts,
  feedRoute,
  FEED_PAGE_SIZE,
  type FeedFilter,
} from "@utils/getFeedPosts";
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("blog");
  return (["all", "weblog", "devlog", "writing"] as const).flatMap((filter) =>
    paginate(getFeedPosts(posts, filter).posts, {
      params: { filter },
      pageSize: FEED_PAGE_SIZE,
    }),
  );
};
const { page } = Astro.props;
const filter = Astro.params.filter as FeedFilter;
const nextRoute = page.url.next
  ? feedRoute(filter, page.currentPage + 1)
  : null;
---

<FeedSection posts={page.data} nextPage={page.url.next ?? null} {nextRoute} />
