---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
interface Props {
  page: Page<CollectionEntry<"blog">>;
}
import { getCollection } from "astro:content";
import Feed from "@layouts/Feed.astro";
import { getFeedPosts, feedRoute, FEED_PAGE_SIZE } from "@utils/getFeedPosts";
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const { posts } = getFeedPosts(await getCollection("blog"), "all");
  return paginate(posts, { pageSize: FEED_PAGE_SIZE });
};
const { page } = Astro.props;
const { selected } = getFeedPosts(await getCollection("blog"), "all");
const nextPage = page.url.next ? `/feed/all/${page.currentPage + 1}/` : null;
const nextRoute = page.url.next ? feedRoute("all", page.currentPage + 1) : null;
---

<Feed
  filter="all"
  selected={page.currentPage === 1 ? selected : []}
  posts={page.data}
  {nextPage}
  {nextRoute}
/>
